{
  "format_on_save": "on",
  "formatter": [
    {
      "language_server": {
        "name": "oxfmt"
      }
    }
  ],
  "code_actions_on_format": {
    "source.fixAll.oxc": true
  },
  "lsp": {
    "oxlint": {
      "binary": {
        "path": "node_modules/.bin/oxlint"
      },
      "initialization_options": {
        "settings": {
          "configPath": ".oxlintrc.json",
          "run": "onType",
          "typeAware": true
        }
      }
    },
    "oxfmt": {
      "binary": {
        "path": "node_modules/.bin/oxfmt"
      },
      "initialization_options": {
        "settings": {
          "fmt.configPath": ".oxfmtrc.json",
          "run": "onSave"
        }
      }
    },
    "eslint": {
      "enable": false
    }
  },
  "languages": {
    "JavaScript": {
      "language_servers": ["oxlint", "oxfmt", "!eslint", "..."],
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "TypeScript": {
      "language_servers": ["oxlint", "oxfmt", "!eslint", "..."],
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "JSX": {
      "language_servers": ["oxlint", "oxfmt", "!eslint", "..."],
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "TSX": {
      "language_servers": ["oxlint", "oxfmt", "!eslint", "..."],
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "Vue": {
      "language_servers": ["oxlint", "oxfmt", "!eslint", "..."],
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "JSON": {
      "language_servers": ["oxfmt", "..."],
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    },
    "JSONC": {
      "language_servers": ["oxfmt", "..."],
      "prettier": {
        "allowed": false
      },
      "formatter": [
        {
          "language_server": {
            "name": "oxfmt"
          }
        }
      ]
    }
  }
}
